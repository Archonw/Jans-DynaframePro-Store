{
  "type": "wifi",
  "name": {"de": "WLAN für Gäste", "en": "Guest Wi-Fi", "es": "Wi-Fi para invitados"},
  "description": {
    "de": "Zeigt Netzwerkname, Passwort und einen QR-Code, mit dem sich Gäste per Handykamera ins WLAN einwählen. Nachbau von MMM-WiFiPassword.",
    "en": "Shows network name, password and a QR code guests scan with their phone camera to join your Wi-Fi. Rebuild of MMM-WiFiPassword.",
    "es": "Muestra el nombre de la red, la contraseña y un código QR que los invitados escanean con la cámara para conectarse al Wi-Fi. Versión de MMM-WiFiPassword."
  },
  "version": "1.0.0",
  "author": "Jan · inspired by TeraTech/MMM-WiFiPassword",
  "url": "https://github.com/TeraTech/MMM-WiFiPassword",
  "region": "bottom_left",
  "script": "module.js",
  "style": "module.css",
  "fields": [
    {"key": "ssid", "kind": "text", "default": "",
     "label": {"de": "Netzwerkname (SSID)", "en": "Network name (SSID)", "es": "Nombre de la red (SSID)"}},
    {"key": "password", "kind": "text", "default": "",
     "label": {"de": "Passwort", "en": "Password", "es": "Contraseña"},
     "hint": {"de": "Steht im QR-Code, auch wenn „Passwort zeigen“ aus ist. Am besten ein Gästenetz verwenden.",
              "en": "Goes into the QR code even when “Show password” is off. A guest network is best.",
              "es": "Va en el código QR aunque «Mostrar contraseña» esté desactivado. Mejor usar una red de invitados."}},
    {"key": "auth", "kind": "select", "default": "WPA",
     "label": {"de": "Verschlüsselung", "en": "Security", "es": "Seguridad"},
     "options": [{"value": "WPA", "label": "WPA / WPA2 / WPA3"},
                 {"value": "WEP", "label": "WEP"},
                 {"value": "nopass", "label": {"de": "offen (ohne Passwort)", "en": "open (no password)", "es": "abierta (sin contraseña)"}}]},
    {"key": "hidden", "kind": "bool", "default": false,
     "label": {"de": "Netzwerk ist versteckt", "en": "Network is hidden", "es": "Red oculta"}},
    {"key": "size", "kind": "select", "default": "medium",
     "label": {"de": "Größe des QR-Codes", "en": "QR code size", "es": "Tamaño del código QR"},
     "options": [{"value": "small", "label": {"de": "klein", "en": "small", "es": "pequeño"}},
                 {"value": "medium", "label": {"de": "mittel", "en": "medium", "es": "mediano"}},
                 {"value": "large", "label": {"de": "groß", "en": "large", "es": "grande"}},
                 {"value": "xlarge", "label": {"de": "sehr groß", "en": "extra large", "es": "muy grande"}}]},
    {"key": "layout", "kind": "select", "default": "vertical",
     "label": {"de": "Anordnung", "en": "Layout", "es": "Disposición"},
     "options": [{"value": "vertical", "label": {"de": "Text unter dem QR-Code", "en": "Text below the QR code", "es": "Texto debajo del código"}},
                 {"value": "horizontal", "label": {"de": "Text neben dem QR-Code", "en": "Text beside the QR code", "es": "Texto junto al código"}}]},
    {"key": "showNetwork", "kind": "bool", "default": true,
     "label": {"de": "Netzwerkname zeigen", "en": "Show network name", "es": "Mostrar nombre de la red"}},
    {"key": "showPassword", "kind": "bool", "default": true,
     "label": {"de": "Passwort zeigen", "en": "Show password", "es": "Mostrar contraseña"}},
    {"key": "showAuth", "kind": "bool", "default": false,
     "label": {"de": "Verschlüsselung zeigen", "en": "Show security type", "es": "Mostrar tipo de seguridad"}},
    {"key": "showHint", "kind": "bool", "default": true,
     "label": {"de": "Hinweis „Mit der Kamera scannen“", "en": "Hint “Scan with your camera”", "es": "Aviso «Escanea con la cámara»"}}
  ]
}
