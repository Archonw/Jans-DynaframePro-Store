    <string name="src_phone_how">Nothing to set up: pick photos on the Send tab, or share them from your gallery with \"Show on DynaFrame\".</string>
    <string name="src_nas">Network drive (NAS)</string>
    <string name="src_nas_sub">Windows share, Synology, QNAP, Unraid, FRITZ!Box</string>
    <string name="src_nas_how">DynaFrame connects the shared folder (SMB) and shows the photos straight from there; nothing is copied. You need the user name and password of the share.</string>
    <string name="src_webdav">Nextcloud, ownCloud or WebDAV</string>
    <string name="src_webdav_sub">your own cloud or a WebDAV address</string>
    <string name="src_webdav_how">DynaFrame connects to your cloud over WebDAV (still beta in DynaFrame). For Nextcloud, create an app password under Settings → Security and use the WebDAV address shown under Files → Settings.</string>
    <string name="src_usb">USB stick or drive</string>
    <string name="src_usb_sub">plugged into the frame</string>
    <string name="src_usb_how">Plug the stick into the frame first. DynaFrame then shows the chosen folders straight from the stick.</string>
