{
  "type": "jellyfin",
  "name": {"de": "Jellyfin: läuft gerade", "en": "Jellyfin: now playing", "es": "Jellyfin: en reproducción"},
  "description": {
    "de": "Was gerade auf deinem Jellyfin-Server läuft: Musik, Film, Serienfolge oder Live-TV mit Cover, Fortschritt und was als Nächstes kommt. Kein offizielles Jellyfin-Produkt.",
    "en": "What's playing on your Jellyfin server: music, movie, episode or live TV with cover, progress and what's up next. Not an official Jellyfin product.",
    "es": "Lo que se reproduce en tu servidor Jellyfin: música, película, episodio o TV en directo con portada, progreso y lo siguiente. No es un producto oficial de Jellyfin."
  },
  "version": "1.0.0",
  "author": "Jan",
  "region": "bottom_left",
  "script": "module.js",
  "style": "module.css",
  "fetch": "fetch.py",
  "every": 10,
  "visibleOnly": true,
  "fields": [
    {"key": "server", "kind": "text", "default": "",
     "label": {"de": "Adresse des Servers", "en": "Server address", "es": "Dirección del servidor"},
     "hint": {"de": "z. B. http://192.168.178.10:8096", "en": "e.g. http://192.168.1.10:8096", "es": "p. ej. http://192.168.1.10:8096"}},
    {"key": "apikey", "kind": "secret", "default": "",
     "label": {"de": "API-Schlüssel", "en": "API key", "es": "Clave API"},
     "hint": {"de": "In Jellyfin unter Dashboard → API-Schlüssel einen neuen Schlüssel anlegen (derselbe wie beim Plugin Jellyfin Now Playing geht auch).",
              "en": "Create one in Jellyfin under Dashboard → API Keys (the one from the Jellyfin Now Playing plugin works too).",
              "es": "Créala en Jellyfin en Panel → Claves API (sirve también la del plugin Jellyfin Now Playing)."}},
    {"key": "user", "kind": "text", "default": "",
     "label": {"de": "Benutzer (leer = alle)", "en": "User (empty = everyone)", "es": "Usuario (vacío = todos)"},
     "hint": {"de": "Nur zeigen, was dieser Jellyfin-Benutzer abspielt.", "en": "Only show what this Jellyfin user is playing.",
              "es": "Mostrar solo lo que reproduce este usuario de Jellyfin."}},
    {"key": "media", "kind": "select", "default": "all",
     "label": {"de": "Was zeigen", "en": "What to show", "es": "Qué mostrar"},
     "options": [{"value": "all", "label": {"de": "Musik und Videos", "en": "Music and videos", "es": "Música y vídeos"}},
                 {"value": "music", "label": {"de": "nur Musik", "en": "music only", "es": "solo música"}},
                 {"value": "video", "label": {"de": "nur Filme, Serien und TV", "en": "movies, series and TV only", "es": "solo películas, series y TV"}}]},
    {"key": "layout", "kind": "select", "default": "beside",
     "label": {"de": "Darstellung", "en": "Layout", "es": "Diseño"},
     "options": [{"value": "beside", "label": {"de": "Cover neben dem Text", "en": "Cover beside the text", "es": "Portada junto al texto"}},
                 {"value": "background", "label": {"de": "Cover groß, unscharf im Hintergrund", "en": "Large cover, blurred background", "es": "Portada grande, fondo desenfocado"}},
                 {"value": "text", "label": {"de": "nur Text", "en": "text only", "es": "solo texto"}}]},
    {"key": "cover", "kind": "select", "default": "medium",
     "label": {"de": "Covergröße", "en": "Cover size", "es": "Tamaño de portada"},
     "showIf": {"layout": "beside"},
     "options": [{"value": "small", "label": {"de": "klein", "en": "small", "es": "pequeña"}},
                 {"value": "medium", "label": {"de": "mittel", "en": "medium", "es": "mediana"}},
                 {"value": "large", "label": {"de": "groß", "en": "large", "es": "grande"}}]},
    {"key": "episodeImage", "kind": "select", "default": "series",
     "label": {"de": "Bild bei Serien", "en": "Image for episodes", "es": "Imagen para episodios"},
     "options": [{"value": "series", "label": {"de": "Poster der Serie", "en": "series poster", "es": "póster de la serie"}},
                 {"value": "episode", "label": {"de": "Bild der Folge", "en": "episode image", "es": "imagen del episodio"}}]},
    {"key": "showDetails", "kind": "bool", "default": true,
     "label": {"de": "Album, Staffel und Folge zeigen", "en": "Show album, season and episode", "es": "Mostrar álbum, temporada y episodio"}},
    {"key": "showProgress", "kind": "bool", "default": true,
     "label": {"de": "Fortschritt und Zeiten zeigen", "en": "Show progress and times", "es": "Mostrar progreso y tiempos"}},
    {"key": "showNext", "kind": "bool", "default": true,
     "label": {"de": "„Als Nächstes“ zeigen", "en": "Show “Up next”", "es": "Mostrar «A continuación»"}},
    {"key": "showDevice", "kind": "bool", "default": false,
     "label": {"de": "Gerät und Benutzer zeigen", "en": "Show device and user", "es": "Mostrar dispositivo y usuario"}},
    {"key": "hideIdle", "kind": "bool", "default": true,
     "label": {"de": "Ausblenden, wenn nichts läuft", "en": "Hide when nothing is playing", "es": "Ocultar si no se reproduce nada"}}
  ]
}
