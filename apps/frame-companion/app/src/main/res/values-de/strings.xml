    <string name="src_card_title">Weitere Wege für Fotos auf den Rahmen</string>
    <string name="src_card_sub">NAS, Nextcloud, USB-Stick, Immich, iCloud, Google Drive … Die App richtet ein, was DynaFrame selbst kann, und installiert für den Rest ein Plugin.</string>
    <string name="src_card_button">Fotoquellen einrichten</string>
